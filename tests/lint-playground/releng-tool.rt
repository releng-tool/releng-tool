PACKAGE_DIR = ROOT_DIR / 'package'
detected_packages = [p.name for p in PACKAGE_DIR.rglob('*') if p.is_dir()]

releng_config(
    packages=detected_packages,
)

# rt200-ignore-global-cfg-use
packages = [
    'ignored',
]

# rt300-deprecated-register-path-call
releng_register_path(Path(__file__).parent)
